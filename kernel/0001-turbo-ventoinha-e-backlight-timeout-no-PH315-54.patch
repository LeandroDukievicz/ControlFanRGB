+/*
+ * Raw u64 call on WMID_GUID3. The existing helpers on this GUID pass a
+ * struct; the backlight timeout wants a plain value, so it gets its own.
+ */
+static acpi_status WMID_apge_execute_u64(u32 method_id, u64 in, u64 *out)
+{
+	struct acpi_buffer input = { (acpi_size)sizeof(u64), (void *)&in };
+	struct acpi_buffer result = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object *obj;
+	u64 tmp = 0;
+	acpi_status status;
+
+	status = wmi_evaluate_method(WMID_GUID3, 0, method_id, &input, &result);
+	if (ACPI_FAILURE(status))
+		return status;
+
+	obj = result.pointer;
+	if (obj) {
+		if (obj->type == ACPI_TYPE_BUFFER) {
+			if (obj->buffer.length == sizeof(u32))
+				tmp = *((u32 *)obj->buffer.pointer);
+			else if (obj->buffer.length == sizeof(u64))
+				tmp = *((u64 *)obj->buffer.pointer);
+		} else if (obj->type == ACPI_TYPE_INTEGER) {
+			tmp = (u64)obj->integer.value;
+		}
+	}
+
+	if (out)
+		*out = tmp;
+
+	kfree(result.pointer);
+	return AE_OK;
+}
+
+static ssize_t backlight_timeout_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	acpi_status status;
+	u64 result;
+
+	status = WMID_apge_execute_u64(ACER_WMID_GET_FUNCTION,
+				       ACER_WMID_BACKLIGHT_TIMEOUT_GET, &result);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	/*
+	 * The two constants above are what the firmware answers once the
+	 * setting has been written at least once. Before that, a PH315-54
+	 * answers 0x1E0000000000: the 0x1E is the timeout in seconds, without
+	 * the 0x80000 flag the written values carry. Treat the presence of a
+	 * non-zero timeout field as "enabled" instead of failing the read.
+	 */
+	if (result == ACER_WMID_BACKLIGHT_TIMEOUT_ON_READ)
+		return sysfs_emit(buf, "1\n");
+	if (result == ACER_WMID_BACKLIGHT_TIMEOUT_OFF_READ)
+		return sysfs_emit(buf, "0\n");
+
+	return sysfs_emit(buf, "%d\n",
+			  FIELD_GET(ACER_WMID_BACKLIGHT_TIMEOUT_SECS, result) ? 1 : 0);
+}
+
+static ssize_t backlight_timeout_store(struct device *dev,
+				       struct device_attribute *attr,
+				       const char *buf, size_t count)
+{
+	acpi_status status;
+	u64 result;
+	bool on;
+	int err;
+
+	err = kstrtobool(buf, &on);
+	if (err)
+		return err;
+
+	status = WMID_apge_execute_u64(ACER_WMID_SET_FUNCTION,
+				       on ? ACER_WMID_BACKLIGHT_TIMEOUT_ON
+					  : ACER_WMID_BACKLIGHT_TIMEOUT_OFF,
+				       &result);
+	if (ACPI_FAILURE(status))
+		return -EIO;
+
+	return count;
+}
+static DEVICE_ATTR_RW(backlight_timeout);
+
+/*
+ * Userspace interface for turbo mode.
+ *
+ * acer_toggle_turbo() was only reachable from the chassis turbo key handler
+ * (WMID_GAMING_TURBO_KEY_EVENT, key_num 0x4). Without this, an application
+ * has no way to enable turbo, nor to tell whether it is currently on.
+ *
+ *   /sys/devices/platform/acer-wmi/turbo   0 = off, 1 = on
+ *
+ * Writing the value turbo is already in is a no-op, so the attribute is
+ * idempotent. The physical key toggles the same turbo_state, so reads stay
+ * in sync with it.
+ */
+static ssize_t turbo_show(struct device *dev,
+			  struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", turbo_state);
+}
+
+static ssize_t turbo_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	bool on;
+	int err;
+
+	err = kstrtobool(buf, &on);
+	if (err)
+		return err;
+
+	if (on != !!turbo_state)
+		acer_toggle_turbo();
+
+	return count;
+}
+static DEVICE_ATTR_RW(turbo);
+
+static struct attribute *acer_gaming_attrs[] = {
+	&dev_attr_turbo.attr,
+	&dev_attr_backlight_timeout.attr,
+	NULL,
+};
+
+static umode_t acer_gaming_attr_visible(struct kobject *kobj,
+					struct attribute *attr, int n)
+{
+	if (attr == &dev_attr_turbo.attr)
+		return has_cap(ACER_CAP_TURBO_OC) ? attr->mode : 0;
+
+	if (attr == &dev_attr_backlight_timeout.attr)
+		return wmi_has_guid(WMID_GUID3) ? attr->mode : 0;
+
+	return attr->mode;
+}
+
+static const struct attribute_group acer_gaming_attr_group = {
+	.attrs = acer_gaming_attrs,
+	.is_visible = acer_gaming_attr_visible,
+};
+
+__ATTRIBUTE_GROUPS(acer_gaming_attr);
