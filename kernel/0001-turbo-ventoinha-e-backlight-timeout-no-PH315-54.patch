+/* Generic set/get on WMID_GUID3, as used by the backlight timeout below. */
+#define ACER_WMID_SET_FUNCTION			1
+#define ACER_WMID_GET_FUNCTION			2
+
+/*
+ * Keyboard backlight timeout.
+ *
+ * The firmware blanks the keyboard backlight after roughly a minute without a
+ * keypress, and the WMI colour writes do not reset that counter: an animation
+ * running at 30 fps keeps writing while the keyboard sits dark, and a
+ * keypress brings it straight back. PredatorSense exposes this as a setting
+ * on Windows; there was no way to reach it from Linux.
+ *
+ * Same interface Linuwu-Sense uses for it: WMID_GUID3, method 1 to set and 2
+ * to get, with a bare u64 as the input buffer.
+ */
+#define ACER_WMID_BACKLIGHT_TIMEOUT_GET		0x88401ULL
+#define ACER_WMID_BACKLIGHT_TIMEOUT_ON		0x1E0000088402ULL
+#define ACER_WMID_BACKLIGHT_TIMEOUT_OFF		0x88402ULL
+#define ACER_WMID_BACKLIGHT_TIMEOUT_ON_READ	0x1E0000080000ULL
+#define ACER_WMID_BACKLIGHT_TIMEOUT_OFF_READ	0x80000ULL
+/* Seconds field in the reading, e.g. 0x1E = 30 s. */
+#define ACER_WMID_BACKLIGHT_TIMEOUT_SECS	GENMASK_ULL(47, 40)
+
 #define ACER_GAMING_MISC_SETTING_STATUS_MASK GENMASK_ULL(7, 0)
 #define ACER_GAMING_MISC_SETTING_INDEX_MASK GENMASK_ULL(7, 0)
 #define ACER_GAMING_MISC_SETTING_VALUE_MASK GENMASK_ULL(15, 8)
