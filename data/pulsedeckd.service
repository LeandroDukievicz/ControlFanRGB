[Unit]
Description=PulseDeck — controle de RGB e refrigeração (Acer Predator)
Documentation=https://github.com/LeandroDukievicz/PulseDeck
After=dbus.service systemd-modules-load.service
Requires=dbus.service

[Service]
Type=dbus
BusName=io.github.leandrodukievicz.PulseDeck1
ExecStartPre=/sbin/modprobe facer
ExecStart=__EXEC__
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pulsedeck /sys/devices/platform/acer-wmi
StateDirectory=pulsedeck

[Install]
WantedBy=multi-user.target
